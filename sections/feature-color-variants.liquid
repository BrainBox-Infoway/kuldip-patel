{{ 'feature-color-variants.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="feature-color-variants  section-padding-{{ section.id }}">
  <div class="page-width">
    <div class="fcv-wrapper">
      <div class="fcv-images">
        {% for block in section.blocks %}
          <div class="fcv-image {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
              <img
                  srcset="
                    {% if block.settings.image.width >= 350 %}{{ block.settings.image | image_url: width: 350 }} 350w,{% endif %}
                    {% if block.settings.image.width >= 750 %}{{ block.settings.image | image_url: width: 750 }} 750w,{% endif %}
                    {% if block.settings.image.width >= 1100 %}{{ block.settings.image | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if block.settings.image.width >= 1500 %}{{ block.settings.image | image_url: width: 1500 }} 1500w,{% endif %}
                    {% if block.settings.image.width >= 2200 %}{{ block.settings.image | image_url: width: 2200 }} 2200w,{% endif %}
                    {% if block.settings.image.width >= 3000 %}{{ block.settings.image | image_url: width: 3000 }} 3000w,{% endif %}
                    {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                  "
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                  src="{{ block.settings.image | image_url: width: 1100 }}"
                  loading="eager"
                  fetchpriority="high"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | escape }}"
                >
          </div>
        {% endfor %}
      </div>
      <div class="fcv-content">
        {% if section.settings.heading != blank %}
          <h2 class="fcv-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="fcv-text">
            {{ section.settings.text }}
          </div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="fcv-button">{{ section.settings.button_label }}</a>
        {% endif %}
        <div class="fcv-colors">
          {% for block in section.blocks %}
            <div  class="fcv-color {% if forloop.first %}active{% endif %}"  data-index="{{ forloop.index0 }}">
              <img
              srcset="
                  {% if block.settings.thumbnail.width >= 350 %}{{ block.settings.thumbnail | image_url: width: 350 }} 350w,{% endif %}
                  {% if block.settings.thumbnail.width >= 750 %}{{ block.settings.thumbnail | image_url: width: 750 }} 750w,{% endif %}
                  {% if block.settings.thumbnail.width >= 1100 %}{{ block.settings.thumbnail | image_url: width: 1100 }} 1100w,{% endif %}
                  {% if block.settings.thumbnail.width >= 1500 %}{{ block.settings.thumbnail | image_url: width: 1500 }} 1500w,{% endif %}
                  {% if block.settings.thumbnail.width >= 2200 %}{{ block.settings.thumbnail | image_url: width: 2200 }} 2200w,{% endif %}
                  {% if block.settings.thumbnail.width >= 3000 %}{{ block.settings.thumbnail | image_url: width: 3000 }} 3000w,{% endif %}
                  {{ block.settings.thumbnail | image_url }} {{ block.settings.thumbnail.width }}w
              "
              sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
              src="{{ block.settings.thumbnail | image_url: width: 1100 }}"
              loading="eager"
              fetchpriority="high"
              width="{{ block.settings.thumbnail.width }}"
              height="{{ block.settings.thumbnail.height }}"
              alt="{{ block.settings.thumbnail.alt | escape }}"
              >
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const colors = document.querySelectorAll(".fcv-color");
  const images = document.querySelectorAll(".fcv-image");

  const setActive = i => {
    colors.forEach((c, idx) => c.classList.toggle("active", idx === i));
    images.forEach((img, idx) => img.classList.toggle("is-active", idx === i));
  };

  colors.forEach((el, i) =>
    ["mouseenter", "click", "touchstart"].forEach(evt =>
      el.addEventListener(evt, () => setActive(i))
    )
  );
});
</script>

{% schema %}
{
  "name": "Feature Color Variants",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spectrum of Colors for Every Style"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Explore our diverse range of colors and experience unrivaled quality.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "variant",
      "name": "Color Variant",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main Image"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Color Thumbnail"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature Color Variants"
    }
  ]
}
{% endschema %}